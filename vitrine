      { id: 'rl-xbox-10', type: 'giftcard', provider: 'reloadly', name: 'Xbox Gift Card 10 USD', description: 'Gift card digital Xbox via Reloadly.', usd: 10, fixed: true, brand: 'Xbox', icon: 'gift', accent: 'success', reloadlyProductId: 'xbox-10-us' },
      { id: 'rl-googleplay-10', type: 'giftcard', provider: 'reloadly', name: 'Google Play 10 USD', description: 'Gift card digital Google Play via Reloadly.', usd: 10, fixed: true, brand: 'Google Play', icon: 'gift', accent: 'brand', reloadlyProductId: 'gplay-10-us' },
      { id: 'rl-apple-10', type: 'giftcard', provider: 'reloadly', name: 'Apple Gift Card 10 USD', description: 'Gift card digital Apple/iTunes via Reloadly.', usd: 10, fixed: true, brand: 'Apple', icon: 'gift', accent: 'vip', reloadlyProductId: 'apple-10-us' }
    ];

    const formatMZN = (v) => new Intl.NumberFormat('pt-MZ', { minimumFractionDigits: 2, maximumFractionDigits: 2 }).format(Number(v || 0));
    const formatUSD = (v) => new Intl.NumberFormat('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 }).format(Number(v || 0));
    const escapeHTML = (s) => String(s || '').replace(/[&<>"']/g, (m) => ({ '&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;' }[m]));
    const clean = (s, max = 300) => String(s || '').replace(/[<>]/g, '').trim().slice(0, max);

    function showToast(message, type = 'success') {
      const container = document.getElementById('toastContainer');
      const border = type === 'error' ? 'border-danger-500/30' : type === 'warning' ? 'border-warning-500/30' : 'border-brand-500/30';
      const color = type === 'error' ? 'text-danger-400' : type === 'warning' ? 'text-warning-400' : 'text-brand-400';
      const icon = type === 'error' ? 'alert-octagon' : type === 'warning' ? 'alert-triangle' : 'check-check';
      const el = document.createElement('div');
      el.className = `pointer-events-auto glass-soft rounded-2xl px-4 py-3 shadow-xl ${border} flex items-start gap-3 translate-x-10 opacity-0 transition-all duration-300`;
      el.innerHTML = `<i data-lucide="${icon}" class="w-5 h-5 ${color} shrink-0 mt-0.5"></i><div class="text-sm font-bold text-white">${escapeHTML(message)}</div>`;
      container.appendChild(el);
      lucide.createIcons({ root: el });
      requestAnimationFrame(() => { el.classList.remove('translate-x-10','opacity-0'); });
      setTimeout(() => {
        el.classList.add('translate-x-10','opacity-0');
        setTimeout(() => el.remove(), 300);
      }, 3800);
    }

    function getAppliedFee(usd) {
      if (isUserVip) return 0;
      const value = Number(usd || 0);
      if (value <= 20) return sysTax1;
      if (value <= 50) return sysTax2;
      return sysTax3;
    }

    function decorateReloadlyItem(item) {
      return {
        id: item.id || item.productId || crypto.randomUUID(),
        type: 'giftcard',
        provider: 'reloadly',
        name: item.name || item.productName || 'Gift Card',
        description: item.description || `Gift card ${item.brand || 'digital'} via Reloadly.`,
        usd: Number(item.usd || item.amount || item.fixedRecipientDenominations?.[0] || 10),
        fixed: item.fixed !== false,
        brand: item.brand || item.senderCurrencyCode || 'Reloadly',
        icon: 'gift',
        accent: 'warning',
        reloadlyProductId: item.reloadlyProductId || item.productId || item.id,
        recipientCurrency: item.recipientCurrencyCode || 'USD'
      };
    }

    async function loadReloadlyCatalog() {
      try {
        const res = await fetch(API.reloadlyCatalog, { headers: { 'Accept': 'application/json' } });
        if (!res.ok) throw new Error(`HTTP ${res.status}`);
        const data = await res.json();
        const list = Array.isArray(data) ? data : Array.isArray(data.products) ? data.products : [];
        const normalized = list.map(decorateReloadlyItem).filter(Boolean);
        if (!normalized.length) throw new Error('Catálogo vazio');
        document.getElementById('reloadlyStatus').textContent = `${normalized.length} itens`; 
        document.getElementById('reloadlyStatus').className = 'text-success-400';
        return normalized;
      } catch (error) {
        console.warn('Reloadly fallback:', error);
        document.getElementById('reloadlyStatus').textContent = 'Modo fallback';
        document.getElementById('reloadlyStatus').className = 'text-warning-400';
        return FALLBACK_RELOADLY;
      }
    }

    function setWalletUI() {
      document.getElementById('walletBalance').textContent = formatMZN(userData?.walletBalance || 0);
    }

    function renderCatalog() {
      const grid = document.getElementById('catalogGrid');
      const q = clean(document.getElementById('catalogSearch').value, 80).toLowerCase();
      const provider = document.getElementById('providerFilter').value;

      const filtered = catalogItems.filter(item => {
        const matchType = currentFilter === 'all' || item.type === currentFilter;
        const matchProvider = provider === 'all' || item.provider === provider;
        const hay = `${item.name} ${item.description} ${item.brand || ''}`.toLowerCase();
        const matchText = !q || hay.includes(q);
        return matchType && matchProvider && matchText;
      });

      document.getElementById('catalogCount').textContent = filtered.length;
      document.getElementById('giftcardCount').textContent = catalogItems.filter(i => i.provider === 'reloadly').length;

      if (!filtered.length) {
        grid.innerHTML = `<div class="sm:col-span-2 xl:col-span-3 glass-soft rounded-3xl p-10 text-center border border-dashed border-slate-700"><i data-lucide="search-x" class="w-10 h-10 mx-auto text-slate-500 mb-3"></i><p class="text-lg font-bold text-white">Nenhum item encontrado</p><p class="text-sm text-slate-400 mt-1">Tente ajustar os filtros ou a pesquisa.</p></div>`;
        lucide.createIcons({ root: grid });
        return;
      }

      grid.innerHTML = filtered.map(item => {
        const accentClass = item.accent === 'warning' ? 'text-warning-400 bg-warning-500/10 border-warning-500/20' : item.accent === 'success' ? 'text-success-400 bg-success-500/10 border-success-500/20' : item.accent === 'vip' ? 'text-vip-400 bg-vip-500/10 border-vip-500/20' : 'text-brand-400 bg-brand-500/10 border-brand-500/20';
        const providerBadge = item.provider === 'reloadly' ? 'Reloadly' : 'PayGo';
        return `
          <article class="glass-soft rounded-3xl p-5 border border-white/5 card-hover flex flex-col gap-4">
            <div class="flex items-start justify-between gap-3">
              <div class="w-12 h-12 rounded-2xl ${accentClass} border flex items-center justify-center shrink-0">
                <i data-lucide="${item.icon || 'package'}" class="w-5 h-5"></i>
              </div>
              <span class="px-3 py-1 rounded-full text-[10px] font-black uppercase tracking-[0.18em] ${accentClass} border">${providerBadge}</span>
            </div>
            <div>
              <p class="text-[10px] uppercase tracking-[0.18em] text-slate-500 font-black">${item.type}</p>
              <h3 class="mt-1 text-lg font-display font-extrabold text-white leading-tight">${escapeHTML(item.name)}</h3>
              <p class="mt-2 text-sm text-slate-400 leading-relaxed min-h-[60px]">${escapeHTML(item.description)}</p>
            </div>
            <div class="mt-auto flex items-end justify-between gap-4">
              <div>
                <p class="text-[10px] uppercase tracking-[0.18em] text-slate-500 font-black">Preço base</p>
                <p class="text-2xl font-display font-extrabold text-white">${formatUSD(item.usd)} <span class="text-sm text-slate-500">USD</span></p>
              </div>
              <button class="px-4 py-3 rounded-2xl bg-brand-600 hover:bg-brand-500 text-white font-extrabold text-sm shadow-[0_0_16px_rgba(59,130,246,.22)] inline-flex items-center gap-2" data-buy="${item.id}">
                <i data-lucide="shopping-cart" class="w-4 h-4"></i>
                Comprar
              </button>
            </div>
          </article>`;
      }).join('');

      lucide.createIcons({ root: grid });
      grid.querySelectorAll('[data-buy]').forEach(btn => btn.addEventListener('click', () => openCheckout(btn.getAttribute('data-buy'))));
    }

    function updateCheckoutSummary(from = 'usd') {
      const usdInput = document.getElementById('checkoutUsd');
      const mtInput = document.getElementById('checkoutMt');
      let usd = Number(usdInput.value || 0);
      let mt = Number(mtInput.value || 0);

      if (from === 'usd') {
        mt = usd * sysExchangeRate;
        mtInput.value = usd ? mt.toFixed(2) : '';
      } else {
        usd = mt / sysExchangeRate;
        usdInput.value = mt ? usd.toFixed(2) : '';
      }

      const fee = getAppliedFee(usd);
      const base = usd * sysExchangeRate;
      const total = base + fee;
      const wallet = Number(userData?.walletBalance || 0);

      document.getElementById('summaryBase').textContent = `${formatMZN(base)} MT`;
      document.getElementById('summaryFee').textContent = `${formatMZN(fee)} MT`;
      document.getElementById('summaryRate').textContent = `${sysExchangeRate} MT/USD`;
      document.getElementById('summaryTotal').textContent = `${formatMZN(total)} MT`;
      document.getElementById('insufficientWarning').classList.toggle('hidden', !(total > wallet));
      document.getElementById('checkoutBtn').disabled = !usd || total > wallet;
    }

    function openCheckout(id) {
      const item = catalogItems.find(x => x.id === id);
      if (!item) return;
      currentCheckoutItem = item;

      document.getElementById('modalTitle').textContent = item.name;
      document.getElementById('modalType').textContent = item.type === 'giftcard' ? 'Gift Card' : item.type === 'game' ? 'Jogo' : 'Serviço';
      document.getElementById('modalName').textContent = item.name;
      document.getElementById('modalDescription').textContent = item.description;
      document.getElementById('modalProviderBadge').textContent = item.provider === 'reloadly' ? 'Reloadly' : 'PayGo';
      document.getElementById('checkoutUsd').value = Number(item.usd).toFixed(2);
      document.getElementById('checkoutMt').value = (Number(item.usd) * sysExchangeRate).toFixed(2);
      document.getElementById('serviceIdentifier').value = '';
      document.getElementById('serviceNotes').value = '';
      document.getElementById('recipientEmail').value = currentUser?.email || '';
      document.getElementById('recipientName').value = userData?.name || '';
      document.getElementById('reloadlyRecipientBox').classList.toggle('hidden', item.provider !== 'reloadly');
      document.getElementById('serviceBox').classList.remove('hidden');
      updateCheckoutSummary('usd');
      document.getElementById('checkoutModal').classList.replace('hidden', 'flex');
      lucide.createIcons();
    }

    window.closeCheckoutModal = function() {
      document.getElementById('checkoutModal').classList.replace('flex', 'hidden');
      currentCheckoutItem = null;
    };

    async function debitWalletAndLog(totalMt, detail, extra = {}) {
      await updateDoc(doc(db, 'users', currentUser.uid), { walletBalance: increment(-totalMt) });
      await addDoc(collection(db, 'wallet_transactions'), {
        userId: currentUser.uid,
        type: 'debit',
        amount: totalMt,
        description: detail,
        reference: extra.reference || `SHOP-${Date.now()}`,
        createdAt: new Date().toISOString()
      });
    }

    async function createManualOrder(item, usd, mt, fee, total) {
      const identifier = clean(document.getElementById('serviceIdentifier').value, 150);
      const notes = clean(document.getElementById('serviceNotes').value, 800);
      const orderId = `PGV-${Math.random().toString(36).slice(2, 8).toUpperCase()}`;
      const detail = `[${item.type.toUpperCase()}][VITRINE] Item: ${item.name} | ID/Login: ${identifier || 'N/A'} | Notas: ${notes || 'N/A'} | USD: ${usd.toFixed(2)} | Câmbio: ${sysExchangeRate} | Taxa: ${fee.toFixed(2)} MT | Total: ${total.toFixed(2)} MT`;

      await debitWalletAndLog(total, `Compra Vitrine: ${item.name}`, { reference: orderId });
      await addDoc(collection(db, 'orders'), {
        orderId,
        userId: currentUser.uid,
        name: userData?.name || 'Cliente',
        email: currentUser.email || '',
        category: item.type === 'game' ? 'game' : 'digital',
        type: 'vitrine',
        detail,
        usd,
        exchangeRate: sysExchangeRate,
        tax: fee,
        total,
        paymentMethod: 'wallet',
        isPaid: true,
        status: 'processing',
        digitalData: { accountOrId: identifier || '', notes },
        createdAt: serverTimestamp()
      });
    }

    async function createReloadlyOrder(item, usd, mt, fee, total) {
      const recipientEmail = clean(document.getElementById('recipientEmail').value, 120);
      const recipientName = clean(document.getElementById('recipientName').value, 120);
      const identifier = clean(document.getElementById('serviceIdentifier').value, 150);
      const notes = clean(document.getElementById('serviceNotes').value, 800);

      if (!recipientEmail || !recipientName) throw new Error('Preencha o nome e e-mail do destinatário do gift card.');

      const res = await fetch(API.reloadlyOrder, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
        body: JSON.stringify({
          productId: item.reloadlyProductId,
          amount: Number(usd.toFixed(2)),
          recipientEmail,
          recipientName,
          senderName: userData?.name || 'PayGo Cliente',
          senderEmail: currentUser.email || recipientEmail,
          customIdentifier: identifier || null,
          notes: notes || null
        })
      });

      const data = await res.json().catch(() => ({}));
      if (!res.ok) throw new Error(data?.error || data?.message || `Reloadly falhou com HTTP ${res.status}.`);

      const orderId = `RLD-${Math.random().toString(36).slice(2, 8).toUpperCase()}`;
      const detail = `[GIFTCARD][RELOADLY] Item: ${item.name} | Destinatário: ${recipientName} <${recipientEmail}> | Ref Reloadly: ${data.referenceId || data.transactionId || 'N/A'} | USD: ${usd.toFixed(2)} | Câmbio: ${sysExchangeRate} | Taxa: ${fee.toFixed(2)} MT | Total: ${total.toFixed(2)} MT | Notas: ${notes || 'N/A'}`;

      await debitWalletAndLog(total, `Gift Card Reloadly: ${item.name}`, { reference: data.referenceId || orderId });
      await addDoc(collection(db, 'orders'), {
        orderId,
        userId: currentUser.uid,
        name: userData?.name || 'Cliente',
        email: currentUser.email || '',
        category: 'digital',
        type: 'giftcard_reloadly',
        detail,
        usd,
        exchangeRate: sysExchangeRate,
        tax: fee,
        total,
        paymentMethod: 'wallet',
        isPaid: true,
        status: 'completed',
        reloadly: {
          provider: 'reloadly',
          productId: item.reloadlyProductId,
          transactionId: data.transactionId || null,
          referenceId: data.referenceId || null,
          recipientEmail,
          recipientName
        },
        createdAt: serverTimestamp()
      });
    }

    window.processCatalogCheckout = async function() {
      if (!currentCheckoutItem) return;

      const btn = document.getElementById('checkoutBtn');
      const original = btn.innerHTML;
      btn.disabled = true;
      btn.innerHTML = '<i data-lucide="loader-2" class="w-5 h-5 animate-spin"></i> A processar...';
      lucide.createIcons({ root: btn });

      try {
        const freshUserSnap = await getDoc(doc(db, 'users', currentUser.uid));
        userData = freshUserSnap.data() || userData;
        const usd = Number(document.getElementById('checkoutUsd').value || 0);
        const fee = getAppliedFee(usd);
        const base = usd * sysExchangeRate;
        const total = base + fee;
        const wallet = Number(userData?.walletBalance || 0);

        if (!usd || usd <= 0) throw new Error('Valor inválido.');
        if (total > wallet) throw new Error('Saldo insuficiente na carteira.');

        if (currentCheckoutItem.provider === 'reloadly') {
          await createReloadlyOrder(currentCheckoutItem, usd, base, fee, total);
          showToast('Gift card comprado com sucesso via Reloadly.', 'success');
        } else {
          await createManualOrder(currentCheckoutItem, usd, base, fee, total);
          showToast('Pedido criado com sucesso na vitrine.', 'success');
        }

        const freshAfter = await getDoc(doc(db, 'users', currentUser.uid));
        userData = freshAfter.data() || userData;
        setWalletUI();
        closeCheckoutModal();
      } catch (error) {
        console.error(error);
        showToast(error.message || 'Falha ao concluir compra.', 'error');
      } finally {
        btn.disabled = false;
        btn.innerHTML = original;
        lucide.createIcons({ root: btn });
      }
    };

    async function initSession() {
      onAuthStateChanged(auth, async (user) => {
        if (!user) {
          window.location.href = 'login.html';
          return;
        }
        currentUser = user;

        try {
          const [userSnap, settingsSnap, reloadlyItems] = await Promise.all([
            getDoc(doc(db, 'users', user.uid)),
            getDoc(doc(db, 'settings', 'global')),
            loadReloadlyCatalog()
          ]);

          if (!userSnap.exists()) throw new Error('Utilizador não encontrado.');
          userData = userSnap.data();
          isUserVip = Boolean(userData?.isVip && userData?.vipExpiry?.toDate?.() > new Date());

          if (settingsSnap.exists()) {
            const s = settingsSnap.data();
            sysExchangeRate = Number(s.exchangeRate) || sysExchangeRate;
            sysTax1 = Number(s.tax1) || sysTax1;
            sysTax2 = Number(s.tax2) || sysTax2;
            sysTax3 = Number(s.tax3) || sysTax3;
          }

          document.getElementById('exchangeBadge').textContent = `${sysExchangeRate} MT/USD`;
          document.getElementById('feesBadge').textContent = `${formatMZN(sysTax1)} / ${formatMZN(sysTax2)} / ${formatMZN(sysTax3)} MT`;
          setWalletUI();

          catalogItems = [...LOCAL_ITEMS, ...reloadlyItems];
          renderCatalog();
          lucide.createIcons();
        } catch (error) {
          console.error(error);
          showToast(error.message || 'Erro ao carregar a vitrine.', 'error');
        }
      });
    }

    document.querySelectorAll('.chip').forEach(btn => {
      btn.addEventListener('click', () => {
        document.querySelectorAll('.chip').forEach(chip => chip.classList.remove('active'));
        btn.classList.add('active');
        currentFilter = btn.getAttribute('data-filter');
        renderCatalog();
      });
    });

    document.getElementById('catalogSearch').addEventListener('input', renderCatalog);
    document.getElementById('providerFilter').addEventListener('change', renderCatalog);
    document.getElementById('checkoutUsd').addEventListener('input', () => updateCheckoutSummary('usd'));
    document.getElementById('checkoutMt').addEventListener('input', () => updateCheckoutSummary('mt'));
    document.addEventListener('keydown', (e) => { if (e.key === 'Escape') closeCheckoutModal(); });
    document.addEventListener('DOMContentLoaded', initSession);
  </script>
</body>
</html>
