{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "cleanUrls": true,
  "trailingSlash": false,
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        { "key": "Access-Control-Allow-Credentials", "value": "true" },
        { "key": "Access-Control-Allow-Origin", "value": "*" },
        { "key": "Access-Control-Allow-Methods", "value": "GET,OPTIONS,PATCH,DELETE,POST,PUT" },
        { "key": "Access-Control-Allow-Headers", "value": "X-CSRF-Token, X-Requested-With, Accept, Accept-Version, Content-Length, Content-MD5, Content-Type, Date, X-Api-Version, Authorization, X-NetShop-Signature" }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Strict-Transport-Security", "value": "max-age=63072000; includeSubDomains; preload" }
      ]
    }
  ],
  "rewrites": [
    { "source": "/api/webhooks/netshop", "destination": "/api/netshop-webhook" },
    { "source": "/dashboard", "destination": "/dashboard-paygo-shell.html" },
    { "source": "/admin/dashboard", "destination": "/admin/dashboard.html" },
    { "source": "/admin/pedidos", "destination": "/admin/pedidos.html" },
    { "source": "/admin/clientes", "destination": "/admin/clientes.html" },
    { "source": "/admin/afiliados", "destination": "/admin/afiliados.html" },
    { "source": "/admin/gerar-fatura", "destination": "/admin/gerar-fatura.html" },
    { "source": "/admin/configuracoes", "destination": "/admin/configuracoes.html" },
    { "source": "/admin", "destination": "/admin.html" },
    { "source": "/erro", "destination": "/erro.html" }
  ]
}
