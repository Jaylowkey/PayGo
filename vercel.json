{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "cleanUrls": true,
  "trailingSlash": false,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "X-XSS-Protection", "value": "1; mode=block" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Strict-Transport-Security", "value": "max-age=63072000; includeSubDomains; preload" }
      ]
    }
  ],
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/index.js" },
    { "source": "/admin/dashboard", "destination": "/admin/dashboard.html" },
    { "source": "/admin/pedidos", "destination": "/admin/pedidos.html" },
    { "source": "/admin/clientes", "destination": "/admin/clientes.html" },
    { "source": "/admin/afiliados", "destination": "/admin/afiliados.html" },
    { "source": "/admin/gerar-fatura", "destination": "/admin/gerar-fatura.html" },
    { "source": "/admin/configuracoes", "destination": "/admin/configuracoes.html" },
    { "source": "/admin", "destination": "/admin.html" }
  ]
}
